{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "swagger-typescript-api generate -p ./openapi.json -o ./src/api/generated -n dendroScalePatterns.ts --axios --modular --module-name-first-tag --single-http-client --enum-style union --type-only-imports --import-file-extension .ts --extract-request-body --extract-response-body --clean-output --api-class-name DendroScalePatternsApi",
