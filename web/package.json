    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "swagger-typescript-api": "^13.14.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
