{
  "openapi": "3.0.3",
  "info": {
    "title": "Dendro Age — домен паттерна",
    "version": "1.0.0",
    "description": "Семь методов услуги dendro_scale_patterns для кодогенерации Axios. Вход и выход исследователя в эту схему не входят."
  },
  "servers": [{ "url": "/" }],
  "tags": [{ "name": "dendro_scale_patterns", "description": "Паттерны дендрошкалы" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "DendroScalePattern": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "short_description": { "type": "string" },
          "full_description": { "type": "string" },
          "status": { "type": "string" },
          "image_url": { "type": "string" },
          "video_url": { "type": "string" },
          "event_year": { "type": "integer", "nullable": true },
          "ring_count": { "type": "integer", "nullable": true },
          "like_count": { "type": "integer" },
          "liked": { "type": "integer" },
          "mine": { "type": "integer" },
          "creator_id": { "type": "integer" }
        }
      },
      "PublishDendroScalePattern": {
        "type": "object",
        "required": ["short_description", "event_year", "ring_count"],
        "properties": {
          "short_description": { "type": "string" },
          "full_description": { "type": "string" },
          "event_year": { "type": "integer" },
          "ring_count": { "type": "integer" }
        }
      },
      "LikeDendroScalePattern": {
        "type": "object",
        "required": ["like"],
        "properties": { "like": { "type": "integer", "enum": [0, 1] } }
      }
    }
  },
  "paths": {
    "/api/dendro_scale_patterns": {
      "get": {
        "tags": ["dendro_scale_patterns"],
        "operationId": "getDendroScalePatterns",
        "summary": "Список опубликованных паттернов",
        "parameters": [
          { "name": "date_from", "in": "query", "schema": { "type": "string" } },
          { "name": "date_to", "in": "query", "schema": { "type": "string" } },
          { "name": "title", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "список",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/DendroScalePattern" } } } }
          }
        }
      },
      "post": {
        "tags": ["dendro_scale_patterns"],
        "operationId": "createDendroScalePattern",
        "summary": "Черновик с фото и видео",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" },
                  "image": { "type": "string", "format": "binary" },
                  "video": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "черновик",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DendroScalePattern" } } }
          }
        }
      }
    },
    "/api/dendro_scale_patterns/feed": {
      "get": {
        "tags": ["dendro_scale_patterns"],
        "operationId": "getDendroScalePatternFeed",
        "summary": "Лента без идентификатора",
        "responses": {
          "200": {
            "description": "первый опубликованный",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DendroScalePattern" } } }
          }
        }
      }
    },
    "/api/dendro_scale_patterns/draft": {
      "get": {
        "tags": ["dendro_scale_patterns"],
        "operationId": "getDendroScalePatternDraft",
        "summary": "Черновик текущего создателя",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "черновик",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DendroScalePattern" } } }
          }
        }
      }
    },
    "/api/dendro_scale_patterns/publish": {
      "put": {
        "tags": ["dendro_scale_patterns"],
        "operationId": "publishDendroScalePattern",
        "summary": "Публикация черновика",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublishDendroScalePattern" } } }
        },
        "responses": {
          "200": {
            "description": "опубликован",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DendroScalePattern" } } }
          }
        }
      }
    },
    "/api/dendro_scale_patterns/{id}": {
      "delete": {
        "tags": ["dendro_scale_patterns"],
        "operationId": "deleteDendroScalePattern",
        "summary": "Логическое удаление",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "удалён" } }
      }
    },
    "/api/dendro_scale_patterns/{id}/like": {
      "post": {
        "tags": ["dendro_scale_patterns"],
        "operationId": "likeDendroScalePattern",
        "summary": "Лайк 1 или снятие 0",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LikeDendroScalePattern" } } }
        },
        "responses": {
          "200": {
            "description": "паттерн",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DendroScalePattern" } } }
          }
        }
      }
    }
  }
}
